#lang shplait

def l = [1, 2, 3]

#//
fun print_list(l :: Listof(Int)):
  match l
  | []: #void
  | cons(val, rst_lst): print(val +& "\n")
                        print_list(rst_lst)

#//
fun double(x :: Int) :: Int:
  x
  
#//
map(double, l)

type Datatype
| intV(n :: Int)
| stringV(s :: String)

fun eat_cookie(n :: Int) :: Int:
  if n > 0 | n - 1 | 0

check: eat_cookie(0)
       ~is 0
check: eat_cookie(7)
       ~is 6
check: eat_cookie(-2)
       ~is 0
check: eat_cookie(100)
       ~is 99

type Posn
| posn(x :: Int,
       y :: Int)

fun flip(p :: Posn) :: Posn:
  match p
  | posn(x, y): posn(y, x)

check: flip(posn(0, 0))
       ~is posn(0, 0)
check: flip(posn(1, 2))
       ~is posn(2, 1)
check: flip(posn(-3, -4))
       ~is posn(-4, -3)
check: flip(posn(2, -2))
       ~is posn(-2, 2)

type Ant
| ant(loc :: Posn,
      weight :: Int)

fun is_ant_home(a :: Ant) :: Boolean:
  match a
  | ant(l, w): if is_home(l)
               | #true
               | #false

fun is_home(p :: Posn) :: Boolean:
  match p
  | posn(x, y): x == 0 && y == 0

check: is_ant_home(ant(posn(0, 0), 1))
       ~is #true
check: is_ant_home(ant(posn(0, 3), 2))
       ~is #false
check: is_ant_home(ant(posn(-1, 2), 1))
       ~is #false

type Animal
| tiger(color :: Symbol,
        stripe_count :: Int)
| snake(color :: Symbol,
        weight :: Int,
        food :: String)

fun is_heavy_animal(a :: Animal) :: Boolean:
  match a
  | tiger(c, s_c): #true
  | snake(c, w, f): w > 2

def zoo :: Listof(Animal) = []

check: is_heavy_animal(snake(#'green, 3, "rats"))
       ~is #true
check: is_heavy_animal(tiger(#'white, 150))
       ~is #true
check: is_heavy_animal(snake(#'green, 1, "rats"))
       ~is #false

fun feed_fish(aq :: Listof(Int)) :: Listof(Int):
  match aq
  | []: []
  | cons(w, rst_lst): cons(w + 1, feed_fish(rst_lst))

check: feed_fish(cons(1, cons(2, cons(3, cons(4, cons(5, []))))))
       ~is cons(2, cons(3, cons(4, cons(5, cons(6, [])))))
check: feed_fish([])
       ~is []
check: feed_fish([2, 7, 11])
       ~is [3, 8, 12]

type Plant
| leaf()
| stem(p :: Plant)
| branch(l :: Plant,
         r :: Plant)

fun plant_forks(p :: Plant) :: Int:
  match p
  | leaf(): 0
  | stem(p): plant_forks(p)
  | branch(l, r): 1 + plant_forks(l) + plant_forks(r)


check: plant_forks(stem(branch(leaf(), branch(leaf(), leaf()))))
       ~is 2
check: plant_forks(stem(leaf()))
       ~is 0
check: plant_forks(branch(branch(branch(leaf(), leaf()), branch(leaf(), leaf())), branch(branch(leaf(), leaf()), branch(leaf(), leaf()))))
       ~is 7

fun add_lists(a :: Listof(Int), b :: Listof(Int)) :: Listof(Int):
  match a
  | [] :
      match b
      | []: []
      | cons(b_l, b_rst): error(#'add, "wrong arity")
  | cons(a_l, a_rst):
      match b
      | []: error(#'add, "wrong arity")
      | cons(b_l, b_rst): cons(a_l + b_l, add_lists(a_rst, b_rst))

check: add_lists([1, 2, 3], [4, 5, 6])
       ~is [5, 7, 9]
check: add_lists([1, 2], [4, 5, 6])
       ~raises "wrong arity"
check: add_lists([], [])
       ~is []
check: add_lists([1, 2], [1])
       ~raises "wrong arity"
