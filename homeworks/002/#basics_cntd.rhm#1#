#lang shplait

type Tree
| leaf(val :: Int)
| node(left :: Tree,
       val :: Int,
       right :: Tree)

/* PART 1 */
fun sum(tree :: Tree) :: Int:
  match tree
  | leaf(v): v
  | node(l, v, r): sum(l) + v + sum(r)

check: sum(node(leaf(5), 6, leaf(7)))
       ~is 18
check: sum(node(leaf(0), 0, leaf(0)))
       ~is 0
check: sum(node(leaf(-5), -6, leaf(-7)))
       ~is -18
check: sum(node(leaf(-5), 6, leaf(7)))
       ~is 8

