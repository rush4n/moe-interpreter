#lang shplait

type Exp
| intE(n :: Int)
| idE(s :: Symbol)
| plusE(l :: Exp,
        r :: Exp)
| multE(l :: Exp,
        r :: Exp)
| appE(s :: Symbol,
       /* PART 2 */
       args :: Listof(Exp))
/* PART 1 */
| maxE(l :: Exp,
       r :: Exp)

type FunDef
| fd(name :: Symbol,
     /* PART 2 */
     params :: Listof(Symbol),
     body :: Exp)

fun parse(s :: Syntax) :: Exp:
  cond
  | syntax_is_integer(s): intE(syntax_to_integer(s))
  | syntax_is_symbol(s): idE(syntax_to_symbol(s))
  | ~else: match s
           | '$left + $right': plusE(parse(left), parse(right))
           | '$left * $right': multE(parse(left), parse(right))
           | 'max($left, $right)': maxE(parse(left), parse(right))
           /* PART 2 */
           | '$sym($arg, ...)': appE(syntax_to_symbol(sym),
                                     map(parse, syntax_to_list('[$arg, ...]'))) 
           | '($e)': parse(e)
           | ~else: error(#'interp, "invalid input " +& s)

module test:
  check: parse('1')
         ~is intE(1)
  check: parse('2 + 3')
         ~is plusE(intE(2), intE(3))
  check: parse('2 * 3')
         ~is multE(intE(2), intE(3))
  check: parse('1 + 2 * 3')
         ~is plusE(intE(1), multE(intE(2), intE(3)))
  check: parse('(1 + 2) * 3')
         ~is multE(plusE(intE(1), intE(2)), intE(3))
  check: parse('1 2')
         ~raises "invalid input"


fun parse_fundef(s :: Syntax) :: FunDef:
  match s
  /* PART 2 */
  | 'fun $name($arg, ...): $body': fd(syntax_to_symbol(name),
                                      map(syntax_to_symbol, syntax_to_list('[$arg, ...]')),
                                      parse(body))
  | ~else: error(#'parse, "invalid function definition " +& s)
           
module test:
  check: parse_fundef('fun double(x): x + x')
         ~is fd(#'double, [#'x], plusE(idE(#'x), idE(#'x)))
  check: parse_fundef('fun quadruple(x): double(double(x))')
         ~is fd(#'quadruple, [#'x], appE(#'double, [appE(#'double, [idE(#'x)])]))
  check: parse_fundef('fun plus_two(x): x + 2')
         ~is fd(#'plus_two, [#'x], plusE(idE(#'x), intE(2)))
  check: parse_fundef('fun (x): x + 2')
         ~raises "invalid function definition"

fun interp(a :: Exp, defs :: Listof(FunDef)) :: Int:
  match a
  | intE(n): n
  | idE(s): error(#'interp, "free variable " +& s)
  | plusE(l, r): interp(l, defs) + interp(r, defs)
  | multE(l, r): interp(l, defs) * interp(r, defs)
  /* PART 2 */
  | appE(fn, args):
      block:
          def df = get_fundef(fn, defs)
          interp_args(args,
                      fd.params(df),
                      fd.body(df),
                      defs)
  | maxE(l, r): maxV(interp(l, defs), interp(r, defs))

module test:
  /* 2 */
  check: interp(intE(2), [])
         ~is 2
  /* #'x */
  check: interp(parse('x'), [])
         ~raises "free variable"
  /* 2 + 3 = 5 */
  check: interp(plusE(intE(2), intE(3)), [])
         ~is 5
  /* 2 * 3 = 6 */
  check: interp(multE(intE(2), intE(3)), [])
         ~is 6
  /* 1 + 2 * 3 = 7 */
  check: interp(plusE(intE(1), multE(intE(2), intE(3))), [])
         ~is 7

  def double_def = parse_fundef('fun double(x): x + x')
  def quadruple_def = parse_fundef('fun quadruple(x): double(double(x))')
  def plus_two_def = parse_fundef('fun plus_two(x): x + 2')

  check: interp(parse('double(4)'), [double_def, quadruple_def, plus_two_def])
         ~is 8
  check: interp(parse('double(4 + 2)'), [double_def, quadruple_def, plus_two_def])
         ~is 12
  check: interp(parse('quadruple(2)'), [double_def, quadruple_def, plus_two_def])
         ~is 8
  check: interp(parse('plus_two(double(2) * 2)'), [double_def, quadruple_def, plus_two_def])
         ~is 10
  check: interp(parse('abs(-2)'), [double_def, quadruple_def, plus_two_def])
         ~raises "undefined function"
  

fun get_fundef(s :: Symbol, defs :: Listof(FunDef)) :: FunDef:
  match defs
  | []: error(#'interp, "undefined function " +& s)
  | cons(df, rst_defs): if fd.name(df) == s
                        | df
                        | get_fundef(s, rst_defs)

fun subst(what :: Exp, for :: Symbol, in :: Exp) :: Exp:
  match in
  | intE(n): in
  | idE(s): if s == for
            | what
            | in
  | plusE(l, r): plusE(subst(what, for, l), subst(what, for, r))
  | multE(l, r): multE(subst(what, for, l), subst(what, for, r))
  /* PART 2 */
  | appE(s, args): appE(s, subst_args(what, for, args))
  /* PART 1 */
  | maxE(l, r): maxE(subst(what, for, l), subst(what, for, r))

module test:
  check: subst(parse('8'), #'x, parse('9'))
         ~is parse('9')
  check: subst(parse('8'), #'x, parse('x'))
         ~is parse('8')
  check: subst(parse('8'), #'x, parse('x + 2'))
         ~is parse('8 + 2')
  check: subst(parse('2 + 4'), #'x, parse('x + y + 2'))
         ~is parse('(2 + 4) + y + 2')
  check: subst(parse('2'), #'x, parse('x + y * 2'))
         ~is parse('2 + y * 2')
  check: subst(parse('8'), #'x, parse('double(x)'))
         ~is parse('double(8)')
  check: subst(parse('8'), #'x, parse('double(x + 2)'))
         ~is parse('double(8 + 2)')
  check: subst(parse('8'), #'x, parse('double(double(x))'))
         ~is parse('double(double(8))')
     
/* PART 1 */
module test:
  check: subst(parse('4'), #'x, parse('max(x, x + y)'))
         ~is parse('max(4, 4 + y)')
  check: subst(parse('4'), #'x, parse('max(4 + 2, x + y)'))
         ~is parse('max(4 + 2, 4 + y)')
  check: interp(parse('max(2, 3)'), [])
         ~is 3
  check: interp(parse('max(double(2), 3)'), [double_def])
         ~is 4
  check: interp(parse('max(double(2), 3 * 2)'), [double_def])
         ~is 6
  check: interp(parse('max(double(2) + plus_two(3), 3 * 2)'), [double_def, plus_two_def])
         ~is 9

fun maxV(l :: Int, r :: Int) :: Int:
  if l > r
  | l
  | r


/* PART 2 */
fun subst_args(what :: Exp, for :: Symbol, args :: Listof(Exp)) :: Listof(Exp):
  match args
  | []: []
  | cons(arg, rst_args): cons(subst(what, for, arg), subst_args(what, for, rst_args))

fun interp_args(args :: Listof(Exp), params :: Listof(Symbol), body :: Exp, defs :: Listof(FunDef)) :: Int:
  match args
  | []:
      match params
      | []: interp(body, defs)
      | cons(param, rst_params): error(#'interp, "wrong arity")
  | cons(arg, rst_args):
      match params
      | []: error(#'interp, "wrong arity")
      | cons(param, rst_params):
          interp_args(rst_args, rst_params, subst(intE(interp(arg, defs)),
                                                  param,
                                                  body),
                      defs)

module  test:
  check: subst(parse('8'), #'x, parse('area(x, x)'))
         ~is parse('area(8, 8)')
  check: interp(parse('max(double(2, 3, 4) + plus_two(3), 3 * 2)'), [double_def, plus_two_def])
         ~raises "wrong arity"
  check: interp(parse('f(1, 2)'),
                [parse_fundef('fun f(x, y): x + y')])
         ~is 3
  check: interp(parse('f() + f()'),
                [parse_fundef('fun f(): 5')])
         ~is 10
  check: interp(parse('f(2, 3)'),
                [parse_fundef('fun f(x, y): y + x + x')])
         ~is 7
  check: interp(parse('f(1)'),
                [parse_fundef('fun f(x, y): x+y')])
         ~raises "wrong arity"
  check: interp(parse('f(x)'),
                [parse_fundef('fun f(a): 1')])
         ~raises "free variable"
  check: interp(parse('f(x)'),
                [parse_fundef('fun f(a): 1')])
         ~raises "free variable"

/* PART 3 UNDER CONSTRUCTION */