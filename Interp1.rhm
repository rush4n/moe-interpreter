#lang shplait

module test:
  check: parse('1')
         ~is intE(1)
  check: parse('x')
         ~is idE(#'x)
  check: parse('1 + 2')
         ~is plusE(intE(1), intE(2))
  check: parse('1 * 2')
         ~is multE(intE(1), intE(2))
  check: parse('1 + 2 * 4')
         ~is plusE(intE(1), multE(intE(2), intE(4)))
  check: parse('(1 + 2) * 4')
         ~is multE(plusE(intE(1), intE(2)), intE(4))
  check: parse('abs(-2)')
         ~is absE(intE(-2))
  check: parse('abs(2)')
         ~is absE(intE(2))
  check: parse('2 / 2')
         ~is divE(intE(2), intE(2))
  check: parse('3 + 2 / 2')
         ~is plusE(intE(3), divE(intE(2),  intE(2)))
  check: parse('sum()')
         ~is sumE([])
  check: parse('sum(1, 2, 4, 5)')
         ~is sumE(cons(intE(1), cons(intE(2), cons(intE(4), cons(intE(5), [])))))
  check: parse('double(9)')
         ~is appE(#'double, intE(9))
  check: parse('1 2')
         ~raises "invalid input"
         
  check: interp(intE(3), [])
         ~is 3
  check: interp(plusE(intE(3), intE(2)), [])
         ~is 5
  check: interp(multE(intE(3), intE(2)), [])
         ~is 6
  check: interp(plusE(intE(3), multE(intE(2), intE(4))), [])
         ~is 11
  check: interp(absE(plusE(intE(1), intE(-4))), [])
         ~is 3
  check: interp(absE(intE(2)), [])
         ~is 2
  check: interp(multE(plusE(absE(intE(-2)), intE(2)), intE(-1)), [])
         ~is -4
  check: interp(divE(intE(2), intE(2)), [])
         ~is 1
  check: interp(divE(intE(2), intE(1)), [])
         ~is 2
  check: interp(plusE(intE(3), divE(intE(2),  intE(2))), [])
         ~is 4
  check: interp(sumE([]), [])
         ~is 0
  check: interp(sumE(cons(intE(1), cons(intE(2), cons(intE(4), cons(intE(5), []))))), [])
         ~is 12
  
         
  check: abs(2)
         ~is 2
  check: abs(-2)
         ~is 2
  check: abs(0)
         ~is 0

type Exp
| intE(n :: Int)
| idE(s :: Symbol)
| plusE(l :: Exp,
        r :: Exp)
| multE(l :: Exp,
        r :: Exp)
| absE(e :: Exp)
| divE(l :: Exp,
       r :: Exp)
| sumE(l_exp :: Listof(Exp))
| appE(s :: Symbol,
       arg :: Exp)

type FunDef
| fd(name :: Symbol,
     arg :: Symbol,
     body :: Exp)

fun interp(a :: Exp, defs :: Listof(FunDef)) :: Int:
  match a
  | intE(n): n
  | idE(s): error(#'interp, "free variable: " +& s)
  | plusE(l, r): interp(l, defs) + interp(r, defs)
  | multE(l, r): interp(l, defs) * interp(r, defs)
  | absE(e): abs(interp(e, defs))
  | divE(l, r): interp(l, defs) / interp(r, defs)
  | sumE(l_exp): sum_all(l_exp, defs)
  | appE(s, arg): def d = get_fundef(s, defs)
                  interp(subst(intE(interp(arg, defs)),
                               fd.arg(d),
                               fd.body(d)), defs)

fun parse(s :: Syntax) :: Exp:
  cond
  | syntax_is_integer(s):
      intE(syntax_to_integer(s))
  | ~else:
      match s
      | '$l + $r': plusE(parse(l),
                         parse(r))
      | '$l * $r':  multE(parse(l),
                          parse(r))
      | '$l / $r': divE(parse(l),
                        parse(r))
      | '$sym($arg)': appE(syntax_to_symbol(sym),
                           parse(arg))
      | 'abs($e)': absE(parse(e))
      | 'sum($e, ...)': sumE(map(parse, syntax_to_list('[$e, ...]')))
      | '($e)': parse(e)
      | ~else:
          error(#'parse, "invalid input: " +& s)

fun parse_fundef(s :: Syntax) :: FunDef:
  match s
  | 'fun $name($arg): $body':
      fd(syntax_to_symbol(name),
         syntax_to_symbol(arg),
         parse(body))
  | ~else:
      error(#'parse, "invalid input: " +& s)

fun get_fundef(s :: Symbol, defs :: Listof(FunDef)) :: FunDef:
  match defs
  | []: error(#'getfundef, "undefined function " +& s)
  | cons(df, rst_defs): if fd.name(df) == s
                        | df
                        | get_fundef(s, rst_defs)

fun subst(what :: Exp, for :: Symbol, in :: Exp) :: Exp:
  match in
  | intE(n): in
  | idE(s): if s == for
            | what
            | in
  | plusE(l, r): plusE(subst(what, for, l),
                       subst(what, for, r))
  | multE(l, r): multE(subst(what, for, l),
                       subst(what, for, r))
  | divE(l, r): divE(subst(what, for, l),
                     subst(what, for, r))
  | absE(e): ....
  | sumE(l): ....
  | appE(s, arg): appE(s, subst(what, for, arg))
  
fun abs(n :: Int) :: Int:
  cond
  | n < 0: -n
  | ~else: n

fun sum_all(l_exp :: Listof(Exp), defs :: Listof(FunDef)) :: Int:
  match l_exp
  | [] : 0
  | cons(e, rst_exps): interp(e, defs) + sum_all(rst_exps, defs)

