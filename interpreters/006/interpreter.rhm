#lang shplait

type Value
| intV(n :: Int)
| closV(arg :: Symbol,
        body :: Exp,
        env :: Env)
| recV(ns :: Listof(Symbol),
       vs :: Listof(Boxof(Value)))

type Exp
| intE(n :: Int)
| idE(s :: Symbol)
| plusE(l :: Exp,
        r :: Exp)
| multE(l :: Exp,
        r :: Exp)
| letE(s :: Symbol,
       rhs :: Exp,
       body :: Exp)
| funE(n :: Symbol,
       body :: Exp)
| appE(fn :: Exp,
       arg :: Exp)
| recordE(ns :: Listof(Symbol),
          args :: Listof(Exp))
| getE(rec :: Exp,
       n :: Symbol)
| setE(rec :: Exp,
       n :: Symbol,
       val :: Exp)
| beginE(l :: Exp,
         r :: Exp)

type Binding
| bind(name :: Symbol,
       val :: Value)

type Env = Listof(Binding)
def mt_env = []
def extend_env = cons 

fun parse(s :: Syntax) :: Exp:
  cond
  | syntax_is_integer(s): intE(syntax_to_integer(s))
  | syntax_is_symbol(s): idE(syntax_to_symbol(s))
  | ~else: match s
           | '{ $field: $expr, ... }': recordE(map(syntax_to_symbol, syntax_to_list('[$field, ...]')),
                                               map(parse, syntax_to_list('[$expr, ...]')))
           | '$exp . $name := $field_exp': setE(parse(exp), syntax_to_symbol(name), parse(field_exp))
           | 'let $s = $rhs:
                $body': letE(syntax_to_symbol(s),
                             parse(rhs),
                             parse(body))
           | '$left + $right': plusE(parse(left), parse(right))
           | '$left * $right': multE(parse(left), parse(right))
           | '$exp . $name': getE(parse(exp), syntax_to_symbol(name))
           | 'fun ($id): $body': funE(syntax_to_symbol(id),
                                      parse(body))
           | '$fn($arg)': appE(parse(fn),
                               parse(arg))
           | 'begin:
                $effect_exp
                $result_exp':
               beginE(parse(effect_exp), parse(result_exp))
           | '($e)': parse(e)
           | ~else: error(#'parse, "invalid input " +& s)

module test:
  check: parse('1')
         ~is intE(1)
  check: parse('2 + 3')
         ~is plusE(intE(2), intE(3))
  check: parse('2 * 3')
         ~is multE(intE(2), intE(3))
  check: parse('1 + 2 * 3')
         ~is plusE(intE(1), multE(intE(2), intE(3)))
  check: parse('(1 + 2) * 3')
         ~is multE(plusE(intE(1), intE(2)), intE(3))
  check: parse('1 2')
         ~raises "invalid input"

fun interp(a :: Exp, env :: Env) :: Value:
  match a
  | intE(n): intV(n)
  | idE(s): lookup(s, env)
  | plusE(l, r): num_plus(interp(l, env), interp(r, env))
  | multE(l, r): num_mult(interp(l, env), interp(r, env))
  | appE(fn, arg):
      match interp(fn, env)
      | closV(n, body, c_env):
          interp(body,
                 extend_env(bind(n, interp(arg, env)),
                            c_env))
      | ~else: error(#'interp, "not a function")
  | funE(n, body): closV(n, body, env)
  | letE(s, rhs, body): interp(body,
                               extend_env(bind(s, interp(rhs, env)),
                                          env))
  | recordE(ns, vs): recV(ns,
                          map(fun (v): box(interp(v, env)), vs))
  | getE(r, n):
      match interp(r, env)
      | recV(ns, vs): unbox(find(n, ns, vs))
      | ~else: error(#'interp, "not a record")
  | setE(r, n, v):
      match interp(r, env)
      | recV(ns, vs):
          let f = interp(v, env):
            set_box(find(n, ns, vs), f)
            f
      | ~else: error(#'interp, "not a record")
  | beginE(l, r):
      begin:
        interp(l, env)
        interp(r, env)
                                         
fun num_op(l :: Value, r :: Value, op) :: Value:
  cond
  | l is_a intV && r is_a intV:
      intV(op(intV.n(l), intV.n(r)))
  | ~else: error(#'interp, "not a number")
  
fun num_plus(l :: Value, r :: Value) :: Value:
  num_op(l, r, fun (l, r): l + r)
           
fun num_mult(l :: Value, r :: Value) :: Value:
  num_op(l, r, fun (l, r): l * r)


module test:
  check: interp(parse('2'), mt_env)
         ~is intV(2)
  check: interp(parse('2 + 3'), mt_env)
         ~is intV(5)
  check: interp(parse('2 * 3'), mt_env)
         ~is intV(6)
  check: interp(parse('1 + 2 * 3'), mt_env)
         ~is intV(7)
  check: interp(parse('let x = 2 * 3:
                          x * 2'), mt_env)
         ~is intV(12)
  check: interp(parse('let x = 2 * 3:
                          x * 2'), mt_env)
         ~is intV(12)
  check: interp(parse('let x = 2 * 3:
                          y * 2'), mt_env)
         ~raises "free variable"
  check: interp(parse('let x = 2 * 3:
                          let x = x * 2:
                            x + 2'), mt_env)
         ~is intV(14)
  check: interp(parse('let y = 10:
                         fun (x): y + x'), mt_env)
         ~is closV(#'x, parse('y + x'),
                   extend_env(bind(#'y, intV(10)),
                              mt_env))
 
  check: interp(parse('let f = (fun (x): x + 2):
                           f(2)'),
                mt_env)
         ~is intV(4)
  check: interp(parse('let y = 10:
                           let f = (fun (x): y + x):
                             f(y)'), mt_env)
         ~is intV(20)
  check: interp(parse('let x = 10:
                         x + (fun (x): x + 2)'), mt_env)
         ~raises "not a number"
  check: interp(parse('let x = 10:
                         x(10)'), mt_env)
         ~raises "not a function"
  check: interp(parse('let x = 1:
                         let f = (fun (y): x + y):
                           let x = 100:
                             f(2)'),
                mt_env)
         ~is intV(3)
  check: interp(parse('let r = { x: 1, y: 1 + 1 }:
                         r.x'), mt_env)
         ~is intV(1)
  check: interp(parse('let r = { x: 1, y: 1 + 1 }:
                         r.x + r.y'), mt_env)
         ~is intV(3)
  check: interp(parse('let r = (fun (v): { x: v + 1, y: v + 2 }):
                         r(2)'), mt_env)
         ~is recV([#'x, #'y], [box(intV(3)), box(intV(4))])
  check: interp(parse('let r = (fun (v): { x: v + 1, y: v + 2 }):
                         r(2).x'), mt_env)
         ~is intV(3)
  check: interp(parse('let r1 = {x : 1, y : 2}:
                         begin:
                           r1.x := 4
                           r1.x + r1.y'), mt_env)
         ~is intV(6)
  check: interp(parse('let r1 = {x : 1, y : 2}:
                         begin:
                           r1.z := 3
                           r1.z'), mt_env)
         ~raises "no such field"
  check: interp(parse('let r1 = {x : 1, y : 2}:
                         begin:
                           r1.y := 3
                           r1.z'), mt_env)
         ~raises "no such field"
  check: interp(parse('let r1 = (fun (x): x):
                         r1.x'), mt_env)
         ~raises "not a record"
  check: interp(parse('let r1 = (fun (x): x):
                         begin:
                           r1.x := 3
                           r1.x'), mt_env)
         ~raises "not a record"

fun lookup(s :: Symbol, env :: Env):
  match env
  | []: error(#'interp, "free variable " +& s)
  | cons(b, rst_b): if s == bind.name(b)
                    | bind.val(b)
                    | lookup(s, rst_b)

module test:
  check: lookup(#'x,
                extend_env(bind(#'y, intV(10)),
                           extend_env(bind(#'x, intV(20)),
                                      extend_env(bind(#'x, intV(30)), mt_env))))
         ~is intV(20)
  check: lookup(#'x,
                extend_env(bind(#'x, intV(10)),
                           extend_env(bind(#'y, intV(20)),
                                      extend_env(bind(#'y, intV(30)), mt_env))))
         ~is intV(10)
  check: lookup(#'y,
                extend_env(bind(#'x, intV(10)),
                           extend_env(bind(#'y, intV(20)),
                                      extend_env(bind(#'y, intV(30)), mt_env))))
         ~is intV(20)
  check: lookup(#'x,
                extend_env(bind(#'y, intV(10)),
                           extend_env(bind(#'y, intV(20)),
                                      extend_env(bind(#'y, intV(30)), mt_env))))
         ~raises "free variable"

fun find(n :: Symbol, ns :: Listof(Symbol), vs :: Listof(Boxof(Value))) :: Boxof(Value):
  match ns
  | []: error(#'interp, "no such field " +& n)
  | cons(ns_n, rst_ns): if ns_n == n
                        | first(vs)
                        | find(n, rst_ns, rest(vs))